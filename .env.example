# JalSetu — copy to apps/web/.env.local. Every external service has a mock/dev mode; nothing here is required for the demo.
JALSETU_SECRET=change-me-long-random-string          # signs session cookies (HMAC)
JALSETU_PEPPER=change-me-another-long-random-string  # salts phone/device/contact hashes
JALSETU_DEMO=1                                       # 1 = one-click demo roles + dev OTP display; set 0 in production
JALSETU_SMS_PROVIDER=mock                            # mock | msg91 | twilio (adapters are stubs; mock prints OTP to console + /dev/inbox)
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
JALSETU_LOCATION_RETENTION_H=24                      # precise location purged this many hours after resolution
JALSETU_DATA_DIR=                                    # defaults to apps/web/.data (dispatch.json and relief.json, physically separate)
